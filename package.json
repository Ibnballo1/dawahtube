{
  "name": "dawahtube",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "mobile:start": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": "pnpm --filter web exec eslint --fix",
    "apps/web/**/*.{json,md}": "pnpm --filter web exec prettier --write"
  }
}
